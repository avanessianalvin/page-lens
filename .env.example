# Copy to .env (git-ignored) and fill in. Read by both app-web and app-mcp.
# Real environment variables override values in this file.

# --- Database ---
# PageLens uses its own schema inside the existing "postgres" database (scripts/db/create-schema.sql).
PAGELENS_DB_URL=jdbc:postgresql://localhost:5432/postgres
PAGELENS_DB_SCHEMA=pagelens
PAGELENS_DB_USER=pagelens
PAGELENS_DB_PASSWORD=change-me

# --- Logging / display ---
# Absolute path recommended (the MCP process may start in any directory).
PAGELENS_LOG_DIR=logs
# IANA zone such as Asia/Yerevan; leave empty to use this machine's zone.
PAGELENS_TIME_ZONE=

# --- Dashboard login ---
PAGELENS_WEB_USERNAME=admin
# bcrypt hash, generated with: java -jar app-web/target/pagelens-web.jar --hash-password
PAGELENS_WEB_PASSWORD_HASH=

# --- Meta app ---
META_APP_ID=
META_APP_SECRET=
# Instagram Login uses its own app id/secret ("Instagram app ID" in the App Dashboard).
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
# Must match a "Valid OAuth redirect URI" in the App Dashboard exactly.
PAGELENS_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# --- Write actions (reply/hide/delete comments, publish). OFF by default; restart after changing. ---
PAGELENS_WRITE_ACTIONS_ENABLED=false
# Staging folder for local video uploads (Facebook Login accounts); files are deleted after publishing.
PAGELENS_UPLOAD_DIR=data/uploads
# Claude's MCP write tools additionally need this, set in the MCP server's env (see SETUP.md §8):
# PAGELENS_MCP_WRITE_TOOLS=true

# --- Sync schedule (Spring cron: sec min hour day month weekday, this machine's zone) ---
PAGELENS_SYNC_CRON=0 0 6,18 * * *
PAGELENS_STORIES_CRON=0 0 */3 * * *

# --- Token encryption ---
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
PAGELENS_ENCRYPTION_KEY=
