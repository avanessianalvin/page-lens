# Copy to .env (git-ignored) and fill in. Read by both app-web and app-mcp.
# Real environment variables override values in this file.

# --- Database ---
# PageLens uses its own schema inside the existing "postgres" database (scripts/db/create-schema.sql).
PAGELENS_DB_URL=jdbc:postgresql://localhost:5432/postgres
PAGELENS_DB_SCHEMA=pagelens
PAGELENS_DB_USER=pagelens
PAGELENS_DB_PASSWORD=change-me

# --- Logging / display ---
# Absolute path recommended (the MCP process may start in any directory).
PAGELENS_LOG_DIR=logs
# IANA zone such as Asia/Yerevan; leave empty to use this machine's zone.
PAGELENS_TIME_ZONE=

# --- Meta app (used from Phase 1) ---
META_APP_ID=
META_APP_SECRET=
# Instagram Login uses its own app id/secret ("Instagram app ID" in the App Dashboard).
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=

# --- Token encryption (used from Phase 1) ---
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
PAGELENS_ENCRYPTION_KEY=
